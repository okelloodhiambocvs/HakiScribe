# HakiScribe-AI environment configuration.
# Copy to `.env` (never commit `.env`). All Meta keys stay server-side.
#
# Get a key: log in at https://dev.meta.ai -> Model API dashboard -> API keys
# -> Create API key (format: LLM_<numeric-id>_<secret>). Paste it into
# your hosting dashboard only - never into this file in git.
# Without a key the app runs fully in deterministic MOCK fallback mode.

# Meta Model API key. META_API_KEY takes precedence; MODEL_API_KEY (the name
# used in Meta's own docs) is accepted as an alias.
META_API_KEY=
MODEL_API_KEY=

# Optional overrides (defaults match official docs - change only if told to).
META_API_BASE=https://api.meta.ai/v1
META_REALTIME_WS=wss://api.meta.ai/v1/asr/realtime
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_SPARK_MODEL=muse-spark-1.3
META_WONDER_MODEL=muse-wonder-1.0

# Server port (hosting platforms inject PORT automatically).
PORT=3000
